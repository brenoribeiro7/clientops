{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": "../frontend",
    "typeRoots": ["../frontend/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@playwright/test": ["node_modules/@playwright/test"],
      "@axe-core/playwright": ["node_modules/@axe-core/playwright"]
    }
  },
  "include": ["*.ts"]
}
