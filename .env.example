# Public, non-secret settings
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
TRUSTED_ORIGINS=http://localhost:8080
TRUSTED_HOSTS=localhost
TRUSTED_PROXY_CIDRS=172.28.0.2/32
PRIVATE_STORAGE_ROOT=/var/lib/clientops/private
LOG_LEVEL=INFO
VITE_API_BASE_PATH=/api/v1

# Replace every placeholder with a locally generated value. Never commit real values.
DATABASE_URL=postgresql+psycopg://clientops_runtime:REPLACE_ME@db:5432/clientops
MIGRATION_DATABASE_URL=postgresql+psycopg://clientops_migrator:REPLACE_ME@db:5432/clientops
CSRF_HMAC_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
RATE_LIMIT_HMAC_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
POSTGRES_PASSWORD=REPLACE_ME
MIGRATION_DATABASE_PASSWORD=REPLACE_ME
RUNTIME_DATABASE_PASSWORD=REPLACE_ME
