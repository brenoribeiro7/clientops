{
  "name": "clientops-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0 && cd ../e2e && ../frontend/node_modules/.bin/eslint . --max-warnings 0",
    "format": "prettier --write . ../e2e ../.github/workflows/ci.yml",
    "format:check": "prettier --check . ../e2e ../.github/workflows/ci.yml",
    "typecheck": "tsc -b --pretty false && tsc -p ../e2e/tsconfig.json --pretty false",
    "test:unit": "vitest run",
    "test:e2e": "NODE_PATH=./node_modules playwright test --config ../e2e/playwright.config.ts",
    "browsers:install": "playwright install chromium firefox webkit",
    "contracts:generate": "openapi-typescript src/contracts/openapi.json -o src/contracts/api.d.ts",
    "contracts:check": "openapi-typescript src/contracts/openapi.json -o src/contracts/api.d.ts --check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
